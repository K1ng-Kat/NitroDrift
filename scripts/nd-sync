#!/bin/bash
set -euo pipefail
PROJECT="$HOME/Documents/NitroDrift"
REPO="https://github.com/K1ng-Kat/NitroDrift.git"
printf '\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n     NITRODRIFT GITHUB SYNC\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n'
printf '📁 Project: %s\n' "$PROJECT"
if [[ ! -e "$PROJECT" ]]; then
  mkdir -p "$HOME/Documents"
  git clone "$REPO" "$PROJECT"
fi
if ! git -C "$PROJECT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo '❌ NitroDrift folder is not a Git repository.'; exit 1
fi
cd "$PROJECT"
remote="$(git remote get-url origin 2>/dev/null || true)"
case "$remote" in
  "$REPO"|"https://github.com/K1ng-Kat/NitroDrift"|"git@github.com:K1ng-Kat/NitroDrift.git") ;;
  *) printf '❌ Unexpected Git remote: %s\n' "$remote"; exit 1 ;;
esac
if [[ -n "$(git ls-files -u)" ]]; then
  echo '❌ Unresolved Git conflict. Settings and stash were not changed.'
  git status --short
  exit 1
fi

# Skip local Xcode scheme files without stashing. Never skip source edits.
metadata_paths=()
metadata_seen=0
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  status="${line:0:2}"
  path="${line:3}"
  case "$path" in
    NitroDrift.xcodeproj/xcuserdata/*)
      metadata_seen=1
      if [[ "$status" == ' M' && -f "$path" ]]; then
        metadata_paths+=("$path")
      elif [[ "$status" != '??' ]]; then
        echo "⚠️ Staged/deleted Xcode preference: $path"; exit 1
      fi
      ;;
    NitroDrift.xcodeproj/xcshareddata/*)
      if [[ "$status" == '??' ]]; then
        metadata_seen=1
      else
        echo '⚠️ Tracked shared Xcode scheme changed; commit or stash it first.'; exit 1
      fi
      ;;
    *)
      echo '⚠️ Local changes detected. Nothing overwritten.'
      git status --short
      echo 'Commit or stash changes before syncing.'
      exit 1
      ;;
  esac
done < <(git status --porcelain=v1 --untracked-files=all)

# For legacy tracked Xcode preferences, use an external backup (not Git stash).
backup_dir=""
restore_metadata() {
  [[ -z "$backup_dir" ]] && return 0
  local path
  for path in "${metadata_paths[@]}"; do
    mkdir -p "$(dirname "$path")"
    if ! cp -p "$backup_dir/$path" "$path"; then
      printf '❌ Your Xcode metadata backup is at %s\n' "$backup_dir"
      return 1
    fi
  done
  rm -rf -- "$backup_dir"
  backup_dir=""
}

if (( ${#metadata_paths[@]} > 0 )); then
  backup_dir="$(mktemp -d "${TMPDIR:-/tmp}/nd-sync-settings.XXXXXXXX")"
  for path in "${metadata_paths[@]}"; do
    mkdir -p "$backup_dir/$(dirname "$path")"
    cp -p "$path" "$backup_dir/$path"
  done
  trap 'restore_metadata || true' EXIT
  echo '🛡️ Preserving personal Xcode preferences (without Git stash)...'
  for path in "${metadata_paths[@]}"; do git restore --worktree -- "$path"; done
fi

printf '🔄 Fetching latest GitHub main...\n'
git fetch origin main
if git show-ref --verify --quiet refs/heads/main; then
  git switch main
else
  git switch --track -c main origin/main
fi
printf '📥 Updating local project...\n'
git merge --ff-only origin/main
if [[ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]]; then
  echo '❌ Branch does not match origin/main; no force reset was attempted.'; exit 1
fi
restore_metadata
trap - EXIT
printf '\n✅ NITRODRIFT FULLY SYNCED!\n'
if [[ "$metadata_seen" == '1' ]]; then
  echo '✅ GitHub main updated; local Xcode settings retained'
else
  echo '✅ Local matches GitHub main'
fi
printf '🔖 Commit: %s\n📂 %s\n\n' "$(git rev-parse --short HEAD)" "$PROJECT"
